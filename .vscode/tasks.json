{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "build debug",
      "type": "shell",
      "command": "make",
      "args": [
        "BUILD_MODE=DEBUG"
      ],
      "windows": {
        "command": "mingw32-make.exe"
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": [
        "$gcc"
      ]
    },
    {
      "label": "build release",
      "type": "shell",
      "command": "make",
      "windows": {
        "command": "mingw32-make.exe"
      },
      "group": "build",
      "problemMatcher": [
        "$gcc"
      ]
    }
  ]
}
